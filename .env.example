# ==============================================================================
# TRIO DEALERS - ENVIRONMENT TEMPLATE
# Copy to .env.local for local development. NEVER commit .env.local or real secrets.
# ==============================================================================

# --- Supabase (Required for Auth, Database, Storage, Realtime) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Optional modern Supabase publishable key alias:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret/service_role key (NEVER expose as NEXT_PUBLIC_):
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Site / Application ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payments: Razorpay (Server-side order & HMAC webhook verification) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- Transactional Email: Resend ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Trio Dealers <orders@triodealers.in>

# --- Rate Limiting: Upstash Redis (Free Tier) ---
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# --- Bot Protection: Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=

# --- Field Encryption (32-byte hex or base64 key for bank/PAN/GSTIN encryption) ---
DATA_ENCRYPTION_KEY=

# --- Monitoring & Analytics ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Web Push (VAPID Keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@triodealers.in

# --- Optional Legacy Display Keys (Empty by default; configured in DB settings) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NO=
NEXT_PUBLIC_BANK_IFSC=
